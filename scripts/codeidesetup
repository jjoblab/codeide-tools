#!/bin/sh
# codeidesetup — SHIM DE DÉPRÉCIATION (v2).
#
# L'installeur v1 est remplacé par `codeide-sdk` (ADR 0010). Ce shim conserve
# les options v1 les plus utilisées et redirige ; il sera retiré à la fin de
# la transition v1 (date annoncée dans le README — à fixer par le propriétaire).
#
# Options v1 traduites :
#   -s VER   -> install build-tools@VER platform-tools@VER (défaut : plus récente)
#   -c       -> + cmdline-tools (install cmdline-tools)
#   -L       -> list
#   -m URL   -> CODEIDE_TOOLS_MANIFEST
#   -a ARCH  -> --arch
#   -i DIR   -> --root DIR (le SDK va dans DIR — v1 : DIR/android-sdk,
#               v2 : la racine EST le SDK ; on passe DIR/android-sdk)
#   -y       -> ignoré (le CLI est non interactif par défaut)
#   -j/-g/-o -> avertissement : hors périmètre du manifeste v2 (le JDK vient du
#               gestionnaire de paquets, git/openssh ne sont pas des composants SDK)
set -u
warn() { printf '\033[0;33m%s\033[0m\n' "$*" >&2; }

SDK=codeide-sdk
command -v "$SDK" >/dev/null 2>&1 || SDK="$(dirname "$0")/../cli/codeide-sdk"
[ -x "$SDK" ] || { printf '%s\n' "codeidesetup est déprécié : installez codeide-sdk (cli/codeide-sdk du dépôt codeide-tools)." >&2; exit 1; }

warn "codeidesetup est DÉPRÉCIÉ — redirection vers codeide-sdk (voir README, section transition v1)."

root='' arch='' manifest='' sdkver='' with_cmdline=false list=false
while getopts "s:cyLm:a:i:j:g:o:h" opt 2>/dev/null; do
  case $opt in
    s) sdkver=$OPTARG ;;
    c) with_cmdline=true ;;
    y) : ;;
    L) list=true ;;
    m) manifest=$OPTARG ;;
    a) arch=$OPTARG ;;
    i) root=$OPTARG ;;
    j) warn "-j : le JDK s'installe via le gestionnaire de paquets (pkg install openjdk-17) — ignoré" ;;
    g|o) warn "-$opt : git/openssh ne sont pas des composants du manifeste v2 — ignoré" ;;
    h) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
  esac
done

args=''
[ -n "$root" ] && args="$args --root $root"
[ -n "$arch" ] && args="$args --arch $arch"
[ -n "$manifest" ] && export CODEIDE_TOOLS_MANIFEST="$manifest"

if $list; then
  # shellcheck disable=SC2086
  exec "$SDK" $args list
fi

comps='build-tools platform-tools'
[ -n "$sdkver" ] && comps="build-tools@$sdkver platform-tools@$sdkver"
$with_cmdline && comps="$comps cmdline-tools"
# shellcheck disable=SC2086
exec "$SDK" $args install $comps
